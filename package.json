{
  "name": "xhannizer0",
  "productName": "XHANNIZER0",
  "version": "2.1.0",
  "private": true,
  "description": "Utilidad post-formateo de Windows limpia y minimalista — Xhanni Studios",
  "author": "Xhanni Studios",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:nsis": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:all": "electron-builder --win nsis portable",
    "test": "node --test \"tests/*.test.js\"",
    "validate:catalog": "node scripts/validate-catalog.js"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "studio.xhanni.xhannizer0",
    "productName": "XHANNIZER0",
    "copyright": "Copyright © 2026 Xhanni Studios",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "src/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-nsis.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "XHANNIZER0",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Xanssj",
        "repo": "XHANNIZER0",
        "releaseType": "release"
      }
    ]
  },
  "homepage": "https://xhannistudios.org"
}
